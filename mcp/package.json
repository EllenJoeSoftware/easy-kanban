{
  "name": "@easy-kanban/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing Easy Kanban to AI agents (Claude, Hermes, etc.)",
  "bin": { "easy-kanban-mcp": "dist/index.js" },
  "scripts": {
