# Copy to .env and change these before first start.
ADMIN_EMAIL=mohapiw@gmail.com
ADMIN_PASSWORD=@vfWp5Jr2x31101982
ADMIN_NAME=Wycliffe

# Port on your PC (the container always listens on 8080 inside)
PORT=8032

# Optional: fixed secret for login tokens (auto-generated and stored in the DB if empty)
JWT_SECRET=

# How long a login lasts (days)
TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to call the API from another host
# (e.g. a future mobile app dev server). "*" allows any.
CORS_ORIGINS=*

# Agents with no heartbeat for this many minutes are shown as offline
AGENT_OFFLINE_MINUTES=15

# Running agent runs older than this are marked failed (0 = never)
STALE_RUN_HOURS=6
